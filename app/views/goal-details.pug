extends layout

block content
  h2 Goal Details

  p
    strong Title:
    |  #{goal.goal_title}
  p
    strong Category:
    |  #{goal.category_name}
  p
    strong Description:
    |  #{goal.goal_description}
  p
    strong Target Amount:
    |  ₦#{goal.target_amount}
  p
    strong Current Amount:
    |  ₦#{goal.current_amount}
  p
    strong Frequency:
    |  #{goal.saving_frequency}
  p
    strong Duration:
    |  #{goal.duration_months} months
  p
    strong Start Date:
    |  #{goal.start_date}
  p
    strong End Date:
    |  #{goal.end_date}
  p
    strong Scheduled Withdrawal Date:
    |  #{goal.scheduled_withdrawal_date}
  p
    strong Status:
    |  #{goal.goal_status}

  p
    a(href=`/goals/${goal.goal_id}/transactions`) View Transactions

  h3 Recent Transactions
  if transactions.length
    table(border="1", cellpadding="8")
      thead
        tr
          th Type
          th Amount
          th Reference
          th Status
          th Payment Method
          th Date
      tbody
        each transaction in transactions
          tr
            td= transaction.transaction_type
            td ₦#{transaction.amount}
            td= transaction.transaction_reference
            td= transaction.transaction_status
            td #{transaction.method_name} (#{transaction.provider_name})
            td= transaction.transaction_date
  else
    p No transactions found for this goal.